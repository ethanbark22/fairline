# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Only NEXT_PUBLIC_* values are sent to the browser; everything else stays on the server.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# The Odds API (used only by scheduled server jobs, never by the browser)
ODDS_API_KEY=your-odds-api-key

# Anthropic (Claude) API
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: a local Postgres for the database tests (see README)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
